@page "/events/{id:int}"

<h2>Event Details</h2>

@if (Event == null)
{
    <p>Event not found.</p>
}
else
{
    <EventCard EventName="@Event.Name"
               EventDate="@Event.Date"
               EventLocation="@Event.Location" />

    <NavLink href="/register/@Event.Id">Register</NavLink>
    <NavLink href="/attendance/@Event.Id">Track Attendance</NavLink>
}

@code {
    [Parameter] public int Id { get; set; }
    public EventModel Event { get; set; }

    protected override void OnInitialized()
    {
        var events = new List<EventModel>
        {
            new EventModel { Id = 1, Name = "Corporate Summit", Date = DateTime.Now.AddDays(10), Location = "New York" },
            new EventModel { Id = 2, Name = "Tech Expo", Date = DateTime.Now.AddDays(20), Location = "Chicago" },
            new EventModel { Id = 3, Name = "Marketing Meetup", Date = DateTime.Now.AddDays(30), Location = "San Francisco" }
        };

        Event = events.FirstOrDefault(e => e.Id == Id);
    }
}
